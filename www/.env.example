# Environment variables required by www/api (FastAPI backend).
# Set the real values in Vercel -> Project -> Settings -> Environment Variables.
# Names are unchanged from the old Node.js functions, so existing Vercel
# env var configuration does NOT need to be re-entered -- it already works.

# --- Firebase Admin SDK (server-side) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key from your service account JSON. If it contains
# literal \n sequences (common when pasted as a single line into Vercel's
# dashboard) the backend converts them to real newlines automatically.
FIREBASE_PRIVATE_KEY=

# Used only by /api/delete-account to re-verify the user's password via the
# Identity Toolkit REST API. Falls back to a hardcoded default (matching the
# old Node code) if unset, but you should set it explicitly.
FIREBASE_WEB_API_KEY=

# --- Google Maps / Places ---
# Public key sent to the browser (must be restricted to your domain in the
# Google Cloud Console).
GOOGLE_MAPS_BROWSER_KEY=
# Private key used only server-side for Places/Geocoding/Routes API calls.
GOOGLE_MAPS_SERVER_KEY=

# --- 2Factor.in OTP provider ---
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=OTP1

# --- OTP session token signing ---
# Any long random string. Used to HMAC-sign the short-lived token that
# proves a phone number was OTP-verified during register/reset flows.
OTP_SESSION_SECRET=

# --- Push notification links ---
PUBLIC_APP_URL=https://liphtup.in
