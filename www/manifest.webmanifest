{
  "id": "./",
  "name": "GoYatra",
  "short_name": "GoYatra",
  "description": "Local ride booking and driver service for Tripura.",
  "lang": "en-IN",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#1A7A2E",
  "categories": ["travel", "navigation", "transportation"],
  "icons": [
    {
      "src": "assets/icons/goyatra-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/goyatra-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/goyatra-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Passenger Home",
      "short_name": "Passenger",
      "url": "./index.html",
      "icons": [{ "src": "assets/icons/goyatra-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Driver Console",
      "short_name": "Driver",
      "url": "./driver.html",
      "icons": [{ "src": "assets/icons/goyatra-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
