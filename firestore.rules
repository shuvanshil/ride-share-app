rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Admins are identified by a Firebase Auth custom claim (set via
    // scripts/set_admin_claim.py or /api/admin/bootstrap), never by a
    // client-writable Firestore field. This ONLY grants extra *read*
    // access for the realtime admin dashboard (live feed, live ride
    // tracking); every admin write still goes through the FastAPI Admin
    // SDK in www/api/routers/admin.py, which this rule has no bearing on.
    function isAdmin() {
      return signedIn() && 'admin' in request.auth.token && request.auth.token.admin == true;
    }

    function userProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function approvedDriver() {
      return signedIn()
        && userProfile().get('role', '') == "driver"
        && userProfile().get('verificationStatus', '') == "approved";
    }

    function rideParticipant() {
      return signedIn()
        && (('passenger_id' in resource.data && resource.data.passenger_id == request.auth.uid)
          || ('passengerId' in resource.data && resource.data.passengerId == request.auth.uid)
          || ('driver_id' in resource.data && resource.data.driver_id == request.auth.uid)
          || ('driverId' in resource.data && resource.data.driverId == request.auth.uid));
    }

    function eligibleDriver() {
      return approvedDriver()
        && request.auth.uid in resource.data.eligible_driver_ids;
    }

    match /rides/{rideId} {
      // Queries must include a matching passenger_id, driver_id, or
      // eligible_driver_ids constraint for Firestore to authorize them.
      // isAdmin() additionally lets the admin console's realtime listeners
      // (live feed, live ride map) read across all rides.
      allow read: if rideParticipant() || eligibleDriver() || isAdmin();

      // Ride creation and every ride mutation are server-owned by FastAPI.
      allow create, update, delete: if false;
    }

    match /driverPresence/{driverId} {
      // Private presence, GPS telemetry, and push tokens are server-only.
      allow read: if false;

      // Availability, GPS, and push-token writes go through FastAPI.
      allow create, update, delete: if false;
    }

    match /driverMapPresence/{driverId} {
      // Contains only coarse, non-contact map data for guest-mode availability.
      // All writes remain server-only through FastAPI.
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /tripHistory/{rideId} {
      allow read: if signedIn()
        && (resource == null
          || ('passenger_id' in resource.data && resource.data.passenger_id == request.auth.uid)
          || ('passengerId' in resource.data && resource.data.passengerId == request.auth.uid)
          || ('driver_id' in resource.data && resource.data.driver_id == request.auth.uid)
          || ('driverId' in resource.data && resource.data.driverId == request.auth.uid)
          || isAdmin());

      // History is written by FastAPI after an authorized ride transition.
      allow create, update, delete: if false;
    }

    match /phoneLoginIndex/{phoneNumber} {
      // Needed before password login; the document contains only login lookup
      // metadata and must not be listable.
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // Profile, role, earnings, verification, and push fields are managed by
      // FastAPI Admin SDK. Clients must not write arbitrary account fields.
      allow create, update, delete: if false;
    }

    // Saved locations (Home/Work/custom favourites) for the passenger home
    // dashboard. One document per user, keyed by uid, owner read/write only.
    // Kept separate from /users so the FastAPI-managed profile document
    // never needs a client-writable path.
    match /savedPlaces/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['home', 'work', 'favorites', 'customPlaces', 'updatedAt'])
        && (!('favorites' in request.resource.data) || request.resource.data.favorites.size() <= 10);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /otpSecurity/{securityId} {
      // OTP cooldowns and attempt counters are server-only.
      allow read, write: if false;
    }

    // Feature 1 (Driver Dashboard): one small counters doc per driver per
    // Asia/Kolkata day, written only by FastAPI (see _bump_daily_stats in
    // api/routers/rides.py). The driver dashboard is currently read through
    // GET /api/rides/driver-dashboard, not a direct client listener, but the
    // owner-read grant here is left in place for a future realtime widget
    // and costs nothing extra to allow.
    match /driverDailyStats/{statId} {
      allow read: if signedIn()
        && (resource == null
          || ('driver_id' in resource.data && resource.data.driver_id == request.auth.uid)
          || ('driverId' in resource.data && resource.data.driverId == request.auth.uid)
          || isAdmin());
      allow create, update, delete: if false;
    }

    // Feature 3 (live trip sharing): a sanitized, contact-free mirror of one
    // active ride, written only by FastAPI while the passenger has sharing
    // turned on (see set_trip_share() in api/routers/rides.py). Deliberately
    // public-read with no auth check -- the point is that a trusted contact
    // with just the link (containing the unguessable ride ID) can open
    // /track without ever needing a LiphtUp account. It never contains phone
    // numbers, the PIN, or any field beyond what set_trip_share() writes,
    // and is deleted the moment the trip ends or sharing is turned off.
    match /tripShareView/{rideId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Feature 3 (emergency SOS): alerts raised from an active ride via
    // POST /api/rides/{id}/sos. Only admins can read these -- they are
    // never shown back to the passenger/driver who triggered them beyond
    // the immediate in-app confirmation, and never listable/writable by
    // any client.
    match /sosAlerts/{alertId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Feature 3 (suspicious activity reporting): reports submitted via
    // POST /api/rides/safety-report. Same admin-only visibility as SOS
    // alerts, and for the same reason -- a report must not be readable or
    // editable by the account it concerns.
    match /safetyReports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Feature 3 (emergency contact management): up to 3 trusted contacts
    // per user, edited directly from the Profile > Safety sheet. Low-risk
    // personal data (name + phone only) following the same owner-only,
    // schema-validated pattern as /savedPlaces above -- no FastAPI route
    // needed for this one.
    match /emergencyContacts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['contacts', 'updatedAt'])
        && request.resource.data.contacts.size() <= 3;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Persistent Pending Ride Requests (Feature 3):
    // Allows passengers to read their own pending requests, and admins to read all.
    // All creation, updates, matching, and cancellation are handled server-side via FastAPI.
    match /pendingRideRequests/{requestId} {
      allow read: if signedIn() && (resource == null || ('passengerId' in resource.data && resource.data.passengerId == request.auth.uid) || ('passenger_id' in resource.data && resource.data.passenger_id == request.auth.uid) || isAdmin());
      allow create, update, delete: if false;
    }

    // Driver Weekly Payments:
    // Drivers can read their own payment verification records, admins can read all.
    // All creation, approval, and decline mutations are server-owned via FastAPI.
    match /driverPayments/{paymentId} {
      allow read: if signedIn() && (resource == null || ('driverId' in resource.data && resource.data.driverId == request.auth.uid) || ('driver_id' in resource.data && resource.data.driver_id == request.auth.uid) || isAdmin());
      allow create, update, delete: if false;
    }

    // System Settings (e.g. driver payment pause configuration):
    // Read-only for authenticated users, writes managed via FastAPI Admin SDK.
    match /systemSettings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
